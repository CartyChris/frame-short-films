# Optional: API deployment used by a compiled macOS build.
# Hosted Vercel and local Vite use their own same-origin API by default.
VITE_API_ORIGIN=https://frame-short-films.vercel.app

# Server-only, optional exact additional origins allowed to call the API.
# Native Tauri origins are already included. Never use a wildcard.
# FRAME_ALLOWED_ORIGINS=https://your-other-mirror.example

# Provider credentials are entered in the application, not in this file.
